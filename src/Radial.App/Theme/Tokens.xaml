<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        Tokens de diseño: colores, tipografía, medidas y radios. Es el ÚNICO sitio con valores visuales literales; los estilos y las
        vistas solo usan estos recursos (con DynamicResource los pinceles, para que la fase 7 pueda cambiar de tema sin tocar nada más).
        Paleta: grafito oscuro con superficies de pizarra y un único acento frío (azul-cian). Sin degradados.
    -->

    <!-- Colores base -->
    <Color x:Key="Color.Bg">#FF0E1014</Color>
    <Color x:Key="Color.Surface1">#FF14171C</Color>
    <Color x:Key="Color.Surface2">#FF1A1E25</Color>
    <Color x:Key="Color.Surface3">#FF222831</Color>
    <Color x:Key="Color.Border">#FF2A313B</Color>
    <Color x:Key="Color.BorderStrong">#FF3A4350</Color>
    <Color x:Key="Color.Text">#FFE7EAEF</Color>
    <Color x:Key="Color.TextSecondary">#FFA3ACB8</Color>
    <Color x:Key="Color.TextMuted">#FF6F7885</Color>
    <Color x:Key="Color.Accent">#FF5BB8F0</Color>
    <Color x:Key="Color.AccentHover">#FF7CCBF7</Color>
    <Color x:Key="Color.AccentSubtle">#FF1B2F3F</Color>
    <Color x:Key="Color.OnAccent">#FF0B1722</Color>
    <Color x:Key="Color.Danger">#FFF0707A</Color>
    <Color x:Key="Color.DangerSubtle">#FF3A1F24</Color>
    <Color x:Key="Color.Success">#FF5FD3A0</Color>
    <Color x:Key="Color.Warning">#FFE8B35B</Color>
    <Color x:Key="Color.WarningSubtle">#FF352B17</Color>
    <Color x:Key="Color.Scrim">#B2080A0D</Color>

    <!-- Pinceles -->
    <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource Color.Bg}" />
    <SolidColorBrush x:Key="Brush.Surface1" Color="{StaticResource Color.Surface1}" />
    <SolidColorBrush x:Key="Brush.Surface2" Color="{StaticResource Color.Surface2}" />
    <SolidColorBrush x:Key="Brush.Surface3" Color="{StaticResource Color.Surface3}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.Text" Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentSubtle" Color="{StaticResource Color.AccentSubtle}" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="{StaticResource Color.OnAccent}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerSubtle" Color="{StaticResource Color.DangerSubtle}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.WarningSubtle" Color="{StaticResource Color.WarningSubtle}" />
    <SolidColorBrush x:Key="Brush.Scrim" Color="{StaticResource Color.Scrim}" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.Transparent" Color="#00000000" />

    <!-- Tipografía -->
    <FontFamily x:Key="Font.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Icon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>
    <sys:Double x:Key="FontSize.Caption">11.5</sys:Double>
    <sys:Double x:Key="FontSize.Body">13</sys:Double>
    <sys:Double x:Key="FontSize.Strong">14</sys:Double>
    <sys:Double x:Key="FontSize.Heading">17</sys:Double>
    <sys:Double x:Key="FontSize.Title">22</sys:Double>

    <!-- Radios -->
    <CornerRadius x:Key="Radius.S">5</CornerRadius>
    <CornerRadius x:Key="Radius.M">8</CornerRadius>
    <CornerRadius x:Key="Radius.L">12</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">14</CornerRadius>

    <!-- Espaciado (escala de 4) -->
    <sys:Double x:Key="Space.1">4</sys:Double>
    <sys:Double x:Key="Space.2">8</sys:Double>
    <sys:Double x:Key="Space.3">12</sys:Double>
    <sys:Double x:Key="Space.4">16</sys:Double>
    <sys:Double x:Key="Space.5">24</sys:Double>
    <sys:Double x:Key="Space.6">32</sys:Double>

    <!-- Sombra moderada (diálogos, desplegables) -->
    <DropShadowEffect x:Key="Shadow.Raised" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.45" Color="#000000" />

    <!-- Duraciones -->
    <Duration x:Key="Motion.Fast">0:0:0.12</Duration>
    <Duration x:Key="Motion.Normal">0:0:0.2</Duration>

</ResourceDictionary>

<UserControl x:Class="Radial.App.Views.ShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:Radial.App.Theme"
             xmlns:c="clr-namespace:Radial.App.Controls"
             xmlns:v="clr-namespace:Radial.App.Views"
             xmlns:rt="clr-namespace:Radial.App.Runtime"
             xmlns:vm="clr-namespace:Radial.Windows.Presentation;assembly=Radial.Windows"
             SizeChanged="OnSizeChanged" PreviewKeyDown="OnPreviewKeyDown">
    <UserControl.Resources>
        <!-- Cada sección se muestra con la vista que corresponde a su modelo. -->
        <DataTemplate DataType="{x:Type vm:EditorViewModel}"><v:EditorView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LibraryViewModel}"><v:LibraryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type rt:DiagnosticsPage}"><v:DiagnosticsView /></DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Brush.Bg}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavColumn" Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ═════════════ Navegación lateral ═════════════ -->
            <Border Background="{DynamicResource Brush.Surface1}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
                <Grid Margin="14,18,14,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="6,0,0,26">
                        <Grid Width="30" Height="30">
                            <Ellipse Stroke="{DynamicResource Brush.Accent}" StrokeThickness="2" />
                            <Ellipse Width="10" Height="10" Fill="{DynamicResource Brush.Accent}" />
                        </Grid>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibleWhenFalse}}">
                            <TextBlock Text="Radial" Style="{StaticResource Text.Heading}" />
                            <TextBlock Text="Menús radiales" Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                    </StackPanel>

                    <ItemsControl Grid.Row="1" ItemsSource="{Binding NavItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton GroupName="Sections" Style="{StaticResource Nav.Item}" Click="OnNavClick" Tag="{Binding Section}" ToolTip="{Binding Title}">
                                    <RadioButton.IsChecked>
                                        <MultiBinding Mode="OneWay" Converter="{x:Static t:AreEqualConverter.Instance}">
                                            <Binding Path="DataContext.Section" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                            <Binding Path="Section" />
                                        </MultiBinding>
                                    </RadioButton.IsChecked>
                                    <StackPanel Orientation="Horizontal">
                                        <c:GlyphIcon Glyph="{Binding IconName}" FontSize="17" Width="22" />
                                        <TextBlock Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibleWhenFalse}}" />
                                    </StackPanel>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Grid.Row="2" Margin="6,0,0,0" Visibility="{Binding IsCompact, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibleWhenFalse}}">
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                   Text="Mantén Ctrl, pulsa el botón central, mueve y suelta para usar el radial." />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═════════════ Contenido ═════════════ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Barra superior -->
                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Background="{DynamicResource Brush.Bg}">
                    <Grid Margin="28,0,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ItemsControl ItemsSource="{Binding Breadcrumb}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <c:GlyphIcon x:Name="Chevron" Glyph="ChevronRight" FontSize="9" Foreground="{DynamicResource Brush.TextMuted}" Margin="8,0" />
                                        <TextBlock x:Name="Crumb" Text="{Binding}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                            <Setter TargetName="Chevron" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Búsqueda global de comandos y navegación (la búsqueda de acciones es la de la biblioteca) -->
                        <Grid x:Name="CommandHost" Grid.Column="1" Width="360" Margin="12,0">
                            <TextBox x:Name="CommandBox" Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}" Padding="36,8,12,8"
                                     t:Attached.Hint="Ir a… o ejecutar un comando (Ctrl+K)" KeyDown="OnCommandKeyDown" LostKeyboardFocus="OnCommandLostFocus" GotKeyboardFocus="OnCommandGotFocus" />
                            <c:GlyphIcon Glyph="Search" FontSize="13" HorizontalAlignment="Left" Margin="12,0,0,0" Foreground="{DynamicResource Brush.TextMuted}" />
                            <Popup IsOpen="{Binding IsCommandOpen, Mode=OneWay}" PlacementTarget="{Binding ElementName=CommandBox}" Placement="Bottom" StaysOpen="True"
                                   AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="6">
                                <Border x:Name="CommandPopupBody" Margin="0,0,24,24" Width="360" Padding="6" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.BorderStrong}"
                                        BorderThickness="1" CornerRadius="{DynamicResource Radius.M}" Effect="{DynamicResource Shadow.Raised}">
                                    <Grid>
                                        <ItemsControl ItemsSource="{Binding CommandResults}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource Button.Ghost}" Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Padding="10,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="28" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <c:GlyphIcon Glyph="{Binding IconName}" FontSize="15" HorizontalAlignment="Left" Foreground="{DynamicResource Brush.Accent}" />
                                                            <StackPanel Grid.Column="1" HorizontalAlignment="Left">
                                                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Brush.Text}" />
                                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Caption}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Sin resultados" Style="{StaticResource Text.Secondary}" Margin="12,10"
                                                   Visibility="{Binding CommandResults.Count, Converter={StaticResource VisibleWhenZero}}" />
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- Estado de guardado y acciones -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource Badge}" Padding="10,5" Margin="0,0,10,0" ToolTip="{Binding SaveDetail}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SaveState}" Value="Unsaved"><Setter Property="Fill" Value="{DynamicResource Brush.Warning}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding SaveState}" Value="Failed"><Setter Property="Fill" Value="{DynamicResource Brush.Danger}" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding SaveState}" Value="ReadOnly"><Setter Property="Fill" Value="{DynamicResource Brush.TextMuted}" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding SaveText}" Style="{StaticResource Text.Secondary}" />
                                </StackPanel>
                            </Border>
                            <Button Content="Descartar" Command="{Binding Discard}" Style="{StaticResource Button.Ghost}" Margin="0,0,6,0"
                                    Visibility="{Binding IsDirty, Converter={StaticResource VisibleWhenTrue}}" />
                            <Button Content="Guardar" Command="{Binding Save}" Style="{StaticResource Button.Primary}" Margin="0,0,10,0" ToolTip="Guardar (Ctrl+S)" />
                            <Button Style="{StaticResource Button.Icon}" Click="OnPreferencesClick" ToolTip="Preferencias">
                                <c:GlyphIcon Glyph="Settings" FontSize="16" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Aviso destacado (p. ej. configuración recuperada) -->
                <Border Grid.Row="1" Background="{DynamicResource Brush.WarningSubtle}" BorderBrush="{DynamicResource Brush.Warning}" BorderThickness="0,0,0,1" Padding="28,10"
                        Visibility="{Binding HasBanner, Converter={StaticResource VisibleWhenTrue}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <c:GlyphIcon Glyph="Warning" FontSize="15" Foreground="{DynamicResource Brush.Warning}" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Banner}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="Cerrar" Command="{Binding DismissBanner}" Style="{StaticResource Button.Ghost}" Padding="10,4" />
                    </Grid>
                </Border>

                <!-- Sección abierta -->
                <ContentControl x:Name="Page" Grid.Row="2" Content="{Binding CurrentPage}" Margin="28,22,20,22" IsTabStop="False" />
            </Grid>
        </Grid>

        <!-- ═════════════ Aviso breve ═════════════ -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28" Padding="18,11" MaxWidth="620"
                CornerRadius="{DynamicResource Radius.M}" BorderThickness="1" Effect="{DynamicResource Shadow.Raised}"
                DataContext="{Binding Dialogs}" Visibility="{Binding HasToast, Converter={StaticResource VisibleWhenTrue}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource Brush.Surface3}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ToastIsError}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Brush.DangerSubtle}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding ToastMessage}" TextWrapping="Wrap" />
        </Border>

        <!-- ═════════════ Diálogo ═════════════ -->
        <Grid x:Name="DialogLayer" DataContext="{Binding Dialogs}" Visibility="{Binding HasDialog, Converter={StaticResource VisibleWhenTrue}}">
            <Border Background="{DynamicResource Brush.Scrim}" />
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="460" Padding="26,24" Background="{DynamicResource Brush.Surface2}"
                    BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="{DynamicResource Radius.L}" Effect="{DynamicResource Shadow.Raised}">
                <StackPanel DataContext="{Binding CurrentDialog}">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Heading}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,10,0,22" />
                    <StackPanel x:Name="DialogButtons" Orientation="Horizontal" HorizontalAlignment="Right" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

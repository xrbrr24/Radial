<UserControl x:Class="Radial.App.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:Radial.App.Theme"
             xmlns:c="clr-namespace:Radial.App.Controls"
             SizeChanged="OnSizeChanged" DataContextChanged="OnDataContextChanged">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="TreeColumn" Width="264" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" MinWidth="250" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition x:Name="InspectorColumn" Width="344" />
        </Grid.ColumnDefinitions>

        <!-- ═════════════ Jerarquía ═════════════ -->
        <Border Style="{StaticResource Card}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Margin="4,0,0,10">
                    <TextBlock Style="{StaticResource Text.Section}" Text="JERARQUÍA" VerticalAlignment="Center" />
                    <Button Style="{StaticResource Button.Icon}" HorizontalAlignment="Right" Command="{Binding CreateGroup}" ToolTip="Crear un grupo en el menú abierto" Width="28" Height="28">
                        <c:GlyphIcon Glyph="New" FontSize="14" />
                    </Button>
                </Grid>
                <TreeView Grid.Row="1" ItemsSource="{Binding Tree}" x:Name="Tree">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <Border Background="{DynamicResource Brush.Transparent}" AllowDrop="True" Padding="2,5,6,5"
                                    PreviewMouseLeftButtonDown="OnNodeMouseDown" PreviewMouseMove="OnNodeMouseMove" DragOver="OnNodeDragOver" Drop="OnNodeDrop">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <c:GlyphIcon Glyph="{Binding IconName}" FontSize="14" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding ItemCount}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="{Binding CountText}" />
                                </Grid>
                            </Border>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                <TextBlock Grid.Row="2" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="4,10,4,0"
                           Text="Arrastra un grupo o una acción sobre otro menú para moverlos." />
            </Grid>
        </Border>

        <!-- ═════════════ Vista previa ═════════════ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,10">
                <ItemsControl ItemsSource="{Binding Path}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding Name}" Click="OnPathClick" Tag="{Binding}" Style="{StaticResource Button.Ghost}" Padding="8,4" FontWeight="SemiBold" />
                                <c:GlyphIcon Glyph="ChevronRight" FontSize="9" Foreground="{DynamicResource Brush.TextMuted}" Margin="2,0"
                                             Visibility="{Binding IsCurrent, Converter={StaticResource VisibleWhenFalse}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Subir un nivel" HorizontalAlignment="Right" Command="{Binding Up}" Style="{StaticResource Button.Ghost}" Padding="10,5" />
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Card}" ClipToBounds="True">
                <Grid>
                    <c:RadialPreview x:Name="Preview" Margin="16" />
                    <TextBlock Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16,0,16,10" TextWrapping="Wrap" TextAlignment="Center"
                               Text="Pulsa un sector para editarlo · arrástralo para moverlo · suelta aquí una acción de la biblioteca" />
                </Grid>
            </Border>

            <Border Grid.Row="2" Margin="0,10,0,0" MinHeight="22">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </Grid>

        <!-- ═════════════ Inspector ═════════════ -->
        <Border Grid.Column="4" Style="{StaticResource Card}" Padding="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,16,12,16">
                <StackPanel>

                    <!-- Sin selección: resumen de los ocho sectores -->
                    <StackPanel Visibility="{Binding HasSelection, Converter={StaticResource VisibleWhenFalse}}">
                        <TextBlock Style="{StaticResource Text.Heading}" Text="{Binding MenuTitle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,14"
                                   Text="Elige un sector del radial para ver y editar lo que hace, o tócalo en esta lista." />
                        <ItemsControl ItemsSource="{Binding Sectors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="OnSectorClick" Tag="{Binding}" Style="{StaticResource Button.Ghost}" HorizontalContentAlignment="Stretch" Padding="8,7" Margin="0,0,0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <c:GlyphIcon Glyph="{Binding IconName}" FontSize="15" HorizontalAlignment="Left" Foreground="{DynamicResource Brush.Accent}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="2" Text="{Binding DirectionName}" Style="{StaticResource Text.Caption}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Sector vacío -->
                    <StackPanel Visibility="{Binding IsEmptySectorSelected, Converter={StaticResource VisibleWhenTrue}}">
                        <TextBlock Style="{StaticResource Text.Heading}" Text="Sector vacío" />
                        <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding SelectedDirectionName}" Margin="0,2,0,12" />
                        <TextBlock Style="{StaticResource Text.Section}" Text="AÑADIR UNA ACCIÓN" Margin="0,0,0,6" />
                        <c:ActionPicker Height="300" />
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,12" Text="Doble clic para colocarla aquí, o arrástrala a cualquier sector." />
                        <Button Command="{Binding CreateGroup}" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <c:GlyphIcon Glyph="Folder" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Crear un grupo aquí" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Sector con contenido -->
                    <StackPanel Visibility="{Binding IsItemSelected, Converter={StaticResource VisibleWhenTrue}}">
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="{DynamicResource Radius.M}" Background="{DynamicResource Brush.AccentSubtle}">
                                <c:GlyphIcon Glyph="{Binding InspectorIconName}" FontSize="20" Foreground="{DynamicResource Brush.Accent}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding InspectorKind}" Style="{StaticResource Text.Strong}" />
                                <TextBlock Text="{Binding SelectedDirectionName}" Style="{StaticResource Text.Secondary}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource Text.Section}" Text="NOMBRE EN EL RADIAL" Margin="0,0,0,6" />
                        <TextBox Text="{Binding LabelText, UpdateSourceTrigger=PropertyChanged}" LostFocus="OnLabelLostFocus" KeyDown="OnLabelKeyDown" MaxLength="64" />
                        <Button Content="Usar el nombre de la acción" Command="{Binding ResetLabel}" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Padding="4,4" Margin="0,4,0,0"
                                Visibility="{Binding HasLabelOverride, Converter={StaticResource VisibleWhenTrue}}" />

                        <!-- Acción -->
                        <StackPanel Visibility="{Binding IsActionSelected, Converter={StaticResource VisibleWhenTrue}}" Margin="0,14,0,0">
                            <TextBlock Style="{StaticResource Text.Section}" Text="QUÉ HACE" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding InspectorSummary}" Style="{StaticResource Text.Mono}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap">
                                <Run Text="{Binding InspectorDefinitionName, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Text}" /><Run Text=" · " /><Run Text="{Binding InspectorCategory, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding InspectorDescription}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding InspectorUsage}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>

                        <!-- Grupo -->
                        <StackPanel Visibility="{Binding IsGroupSelected, Converter={StaticResource VisibleWhenTrue}}" Margin="0,14,0,0">
                            <TextBlock Text="{Binding GroupContentsText}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" />
                            <Button Command="{Binding Enter}" Style="{StaticResource Button.Primary}" Margin="0,10,0,0" HorizontalAlignment="Stretch">
                                <TextBlock Text="Entrar en el grupo" Foreground="{DynamicResource Brush.OnAccent}" FontWeight="SemiBold" />
                            </Button>
                        </StackPanel>

                        <Border Style="{StaticResource Divider}" Margin="0,16" />

                        <ToggleButton x:Name="IconToggle" Style="{StaticResource ToggleButton.Chip}" HorizontalAlignment="Left" Content="Cambiar icono" Margin="0,0,0,8" />
                        <c:IconPicker x:Name="Icons" Visibility="{Binding IsChecked, ElementName=IconToggle, Converter={StaticResource VisibleWhenTrue}}" Margin="0,0,0,8" />

                        <ToggleButton x:Name="ReplaceToggle" Style="{StaticResource ToggleButton.Chip}" HorizontalAlignment="Left" Content="Cambiar por otra acción" Margin="0,0,0,8" />
                        <c:ActionPicker ReplaceMode="True" Height="260" Margin="0,0,0,8" Visibility="{Binding IsChecked, ElementName=ReplaceToggle, Converter={StaticResource VisibleWhenTrue}}" />

                        <WrapPanel Margin="0,6,0,0">
                            <Button Command="{Binding Duplicate}" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal"><c:GlyphIcon Glyph="Copy" FontSize="13" Margin="0,0,6,0" /><TextBlock Text="Duplicar" /></StackPanel>
                            </Button>
                            <Button Command="{Binding ConvertToGroup}" Margin="0,0,8,8" Visibility="{Binding IsActionSelected, Converter={StaticResource VisibleWhenTrue}}">
                                <StackPanel Orientation="Horizontal"><c:GlyphIcon Glyph="Folder" FontSize="13" Margin="0,0,6,0" /><TextBlock Text="Convertir en grupo" /></StackPanel>
                            </Button>
                            <Button Command="{Binding Remove}" Style="{StaticResource Button.Danger}" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <c:GlyphIcon Glyph="Delete" FontSize="13" Margin="0,0,6,0" Foreground="{DynamicResource Brush.Danger}" />
                                    <TextBlock Foreground="{DynamicResource Brush.Danger}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Text" Value="Quitar del sector" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGroupSelected}" Value="True">
                                                        <Setter Property="Text" Value="Eliminar grupo" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Text="Quitar un sector no borra la acción: sigue en la biblioteca." />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

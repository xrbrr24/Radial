<UserControl x:Class="Radial.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t="clr-namespace:Radial.App.Theme"
             xmlns:c="clr-namespace:Radial.App.Controls"
             xmlns:e="clr-namespace:Radial.Core.Editing;assembly=Radial.Core"
             xmlns:vm="clr-namespace:Radial.Windows.Presentation;assembly=Radial.Windows"
             SizeChanged="OnSizeChanged" DataContextChanged="OnDataContextChanged">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="360" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition x:Name="PanelColumn" Width="420" />
        </Grid.ColumnDefinitions>

        <!-- ═════════════ Lista ═════════════ -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,14">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.Title}" Text="Biblioteca de acciones" />
                    <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding ResultText}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ToggleButton x:Name="NewToggle" Style="{StaticResource ToggleButton.Chip}" Padding="16,9" Background="{DynamicResource Brush.Accent}">
                        <StackPanel Orientation="Horizontal">
                            <c:GlyphIcon Glyph="New" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Nueva acción" FontWeight="SemiBold" />
                        </StackPanel>
                    </ToggleButton>
                    <Popup IsOpen="{Binding IsChecked, ElementName=NewToggle, Mode=TwoWay}" PlacementTarget="{Binding ElementName=NewToggle}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="6" HorizontalOffset="-90">
                        <Border Margin="0,0,28,28" Width="290" Padding="6" Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.M}" Effect="{DynamicResource Shadow.Raised}">
                            <StackPanel>
                                <Button Style="{StaticResource Button.Ghost}" Command="{Binding New}" CommandParameter="{x:Static e:ActionKind.Shortcut}" Click="OnNewKind" HorizontalContentAlignment="Left" Padding="10,8">
                                    <StackPanel Orientation="Horizontal"><c:GlyphIcon Glyph="Keyboard" Margin="0,0,10,0" Foreground="{DynamicResource Brush.Accent}" /><StackPanel><TextBlock Text="Atajo de teclado" Foreground="{DynamicResource Brush.Text}" /><TextBlock Text="Graba una combinación" Style="{StaticResource Text.Caption}" /></StackPanel></StackPanel>
                                </Button>
                                <Button Style="{StaticResource Button.Ghost}" Command="{Binding New}" CommandParameter="{x:Static e:ActionKind.Application}" Click="OnNewKind" HorizontalContentAlignment="Left" Padding="10,8">
                                    <StackPanel Orientation="Horizontal"><c:GlyphIcon Glyph="Application" Margin="0,0,10,0" Foreground="{DynamicResource Brush.Accent}" /><StackPanel><TextBlock Text="Aplicación" Foreground="{DynamicResource Brush.Text}" /><TextBlock Text="Un programa con argumentos opcionales" Style="{StaticResource Text.Caption}" /></StackPanel></StackPanel>
                                </Button>
                                <Button Style="{StaticResource Button.Ghost}" Command="{Binding New}" CommandParameter="{x:Static e:ActionKind.File}" Click="OnNewKind" HorizontalContentAlignment="Left" Padding="10,8">
                                    <StackPanel Orientation="Horizontal"><c:GlyphIcon Glyph="Document" Margin="0,0,10,0" Foreground="{DynamicResource Brush.Accent}" /><StackPanel><TextBlock Text="Archivo" Foreground="{DynamicResource Brush.Text}" /><TextBlock Text="Abre un archivo con su programa" Style="{StaticResource Text.Caption}" /></StackPanel></StackPanel>
                                </Button>
                                <Button Style="{StaticResource Button.Ghost}" Command="{Binding New}" CommandParameter="{x:Static e:ActionKind.Folder}" Click="OnNewKind" HorizontalContentAlignment="Left" Padding="10,8">
                                    <StackPanel Orientation="Horizontal"><c:GlyphIcon Glyph="Folder" Margin="0,0,10,0" Foreground="{DynamicResource Brush.Accent}" /><StackPanel><TextBlock Text="Carpeta" Foreground="{DynamicResource Brush.Text}" /><TextBlock Text="Abre una carpeta en el Explorador" Style="{StaticResource Text.Caption}" /></StackPanel></StackPanel>
                                </Button>
                                <Button Style="{StaticResource Button.Ghost}" Command="{Binding New}" CommandParameter="{x:Static e:ActionKind.Url}" Click="OnNewKind" HorizontalContentAlignment="Left" Padding="10,8">
                                    <StackPanel Orientation="Horizontal"><c:GlyphIcon Glyph="Globe" Margin="0,0,10,0" Foreground="{DynamicResource Brush.Accent}" /><StackPanel><TextBlock Text="Dirección web" Foreground="{DynamicResource Brush.Text}" /><TextBlock Text="Una página http o https" Style="{StaticResource Text.Caption}" /></StackPanel></StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>

            <!-- Búsqueda y filtros -->
            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <Grid>
                    <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="38,9,34,9"
                             t:Attached.Hint="Busca por nombre, categoría, etiqueta o combinación (por ejemplo: ctrl s)" />
                    <c:GlyphIcon Glyph="Search" FontSize="14" HorizontalAlignment="Left" Margin="13,0,0,0" Foreground="{DynamicResource Brush.TextMuted}" />
                    <Button Style="{StaticResource Button.Icon}" HorizontalAlignment="Right" Width="28" Height="28" Margin="0,0,5,0" Command="{Binding ClearSearch}" ToolTip="Borrar la búsqueda"
                            Visibility="{Binding SearchText.Length, Converter={StaticResource VisibleWhenNotZero}}">
                        <c:GlyphIcon Glyph="Close" FontSize="11" />
                    </Button>
                </Grid>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding KindFilters}" SelectedItem="{Binding KindFilter}" ItemTemplate="{StaticResource Template.Label}" />
                    <ComboBox Grid.Column="2" ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding CategoryFilter}" ItemTemplate="{StaticResource Template.Label}" />
                    <ComboBox Grid.Column="4" ItemsSource="{Binding PlacedFilters}" SelectedItem="{Binding PlacedFilter}" ItemTemplate="{StaticResource Template.Label}" />
                </Grid>
            </StackPanel>

            <!-- Resultados, agrupados en propias y de fábrica -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="8" ClipToBounds="True">
                <Grid>
                    <ListBox x:Name="List" Style="{StaticResource ListBox.Flat}" SelectionChanged="OnListSelectionChanged"
                             VirtualizingPanel.IsVirtualizing="True" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             PreviewMouseLeftButtonDown="OnRowMouseDown" PreviewMouseMove="OnRowMouseMove" MouseDoubleClick="OnRowDoubleClick">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Section}" Margin="10,12,0,6" />
                                                        <ItemsPresenter />
                                                    </StackPanel>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,8" Background="{DynamicResource Brush.Transparent}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="{DynamicResource Radius.M}" Background="{DynamicResource Brush.Surface3}">
                                        <c:GlyphIcon Glyph="{Binding IconName}" FontSize="16" Foreground="{DynamicResource Brush.Accent}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Border Style="{StaticResource Badge}" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding CategoryName}" Style="{StaticResource Text.Caption}" />
                                        </Border>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                                            <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,5,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource Brush.BorderStrong}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPlaced}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Text="{Binding PlacedText}" Style="{StaticResource Text.Caption}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsUnsupported}" Value="True">
                                        <Setter Property="Opacity" Value="0.55" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320"
                                Visibility="{Binding HasResults, Converter={StaticResource VisibleWhenFalse}}">
                        <c:GlyphIcon Glyph="Search" FontSize="30" Foreground="{DynamicResource Brush.TextMuted}" />
                        <TextBlock Text="Ninguna acción coincide" Style="{StaticResource Text.Strong}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                        <TextBlock Text="Prueba con otras palabras, quita algún filtro o crea una acción nueva." Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Restaurar acciones de fábrica" Command="{Binding RestoreFactory}" Style="{StaticResource Button.Ghost}" Padding="8,5" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <!-- ═════════════ Panel lateral: formulario o detalle ═════════════ -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <Grid>
                <!-- Nada elegido -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="280">
                    <StackPanel.Visibility>
                        <MultiBinding Converter="{x:Static t:ShowWhenEmpty.Instance}">
                            <Binding Path="IsFormOpen" />
                            <Binding Path="Selected" />
                        </MultiBinding>
                    </StackPanel.Visibility>
                    <c:GlyphIcon Glyph="Tag" FontSize="30" Foreground="{DynamicResource Brush.TextMuted}" />
                    <TextBlock Text="Elige una acción" Style="{StaticResource Text.Strong}" HorizontalAlignment="Center" Margin="0,12,0,4" />
                    <TextBlock Text="Verás aquí sus datos y podrás editarla, duplicarla o colocarla en el radial. También puedes arrastrarla al editor." Style="{StaticResource Text.Secondary}"
                               TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>

                <!-- Detalle de la acción elegida -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,18,14,18">
                    <ScrollViewer.Visibility>
                        <MultiBinding Converter="{x:Static t:ShowWhenDetail.Instance}">
                            <Binding Path="IsFormOpen" />
                            <Binding Path="Selected" />
                        </MultiBinding>
                    </ScrollViewer.Visibility>
                    <StackPanel DataContext="{Binding Selected}">
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="52" Height="52" CornerRadius="{DynamicResource Radius.L}" Background="{DynamicResource Brush.AccentSubtle}">
                                <c:GlyphIcon Glyph="{Binding IconName}" FontSize="24" Foreground="{DynamicResource Brush.Accent}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Heading}" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource Text.Secondary}"><Run Text="{Binding KindName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding CategoryName, Mode=OneWay}" /></TextBlock>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Card}" Background="{DynamicResource Brush.Surface2}" Padding="14,12" Margin="0,0,0,14" Visibility="{Binding IsUnsupported, Converter={StaticResource VisibleWhenTrue}}">
                            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Brush.Warning}"
                                       Text="Esta acción no se puede usar: es de un tipo que esta versión de Radial no conoce o no era válida al cargar la configuración. Se conserva tal cual, pero no se puede editar ni ejecutar desde aquí. Puedes eliminarla, o cerrar Radial, corregirla en config.json y volver a abrirlo." />
                        </Border>

                        <TextBlock Style="{StaticResource Text.Section}" Text="QUÉ HACE" Margin="0,0,0,6" />
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Mono}" TextWrapping="Wrap" />

                        <StackPanel Visibility="{Binding Description.Length, Converter={StaticResource VisibleWhenNotZero}}">
                            <TextBlock Style="{StaticResource Text.Section}" Text="DESCRIPCIÓN" Margin="0,16,0,6" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding TagsText.Length, Converter={StaticResource VisibleWhenNotZero}}">
                            <TextBlock Style="{StaticResource Text.Section}" Text="ETIQUETAS" Margin="0,16,0,6" />
                            <TextBlock Text="{Binding TagsText}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource Text.Section}" Text="EN EL RADIAL" Margin="0,16,0,6" />
                        <TextBlock Text="{Binding PlacedText}" Style="{StaticResource Text.Secondary}" />

                        <Border Style="{StaticResource Divider}" Margin="0,18" />

                        <WrapPanel>
                            <Button Content="Editar" Margin="0,0,8,8" Command="{Binding DataContext.Edit, RelativeSource={RelativeSource AncestorType=UserControl}}" Visibility="{Binding IsUnsupported, Converter={StaticResource VisibleWhenFalse}}" />
                            <Button Content="Duplicar" Margin="0,0,8,8" Command="{Binding DataContext.Duplicate, RelativeSource={RelativeSource AncestorType=UserControl}}" Visibility="{Binding IsUnsupported, Converter={StaticResource VisibleWhenFalse}}" />
                            <Button Content="Colocar en el radial" Margin="0,0,8,8" Click="OnPlaceClick" Visibility="{Binding IsUnsupported, Converter={StaticResource VisibleWhenFalse}}" />
                            <Button Content="Eliminar" Style="{StaticResource Button.Danger}" Margin="0,0,8,8" Command="{Binding DataContext.Delete, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Formulario -->
                <Grid Visibility="{Binding IsFormOpen, Converter={StaticResource VisibleWhenTrue}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,18,14,12" DataContext="{Binding Form}">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Heading}" Margin="0,0,0,14" />

                            <StackPanel Visibility="{Binding IsNew, Converter={StaticResource VisibleWhenTrue}}" Margin="0,0,0,14">
                                <TextBlock Style="{StaticResource Text.Section}" Text="TIPO" Margin="0,0,0,6" />
                                <ComboBox ItemsSource="{x:Static vm:ActionFormViewModel.KindOptions}" SelectedValuePath="Kind" ItemTemplate="{StaticResource Template.Name}" SelectedValue="{Binding Kind, Mode=TwoWay}" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource Text.Section}" Text="NOMBRE" Margin="0,0,0,6" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" t:Attached.Hint="Cómo se llama en el radial" />

                            <!-- Atajo -->
                            <StackPanel Visibility="{Binding IsShortcut, Converter={StaticResource VisibleWhenTrue}}" Margin="0,14,0,0">
                                <TextBlock Style="{StaticResource Text.Section}" Text="COMBINACIÓN DE TECLAS" Margin="0,0,0,6" />
                                <c:KeyCaptureBox DataContext="{Binding Key}" />
                            </StackPanel>

                            <!-- Aplicación, archivo, carpeta -->
                            <StackPanel Visibility="{Binding UsesPath, Converter={StaticResource VisibleWhenTrue}}" Margin="0,14,0,0">
                                <TextBlock Style="{StaticResource Text.Section}" Text="{Binding PathLabel}" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" t:Attached.Hint="Ruta completa" />
                                    <Button Grid.Column="1" Content="Examinar…" Command="{Binding Pick}" Margin="8,0,0,0" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsApplication, Converter={StaticResource VisibleWhenTrue}}" Margin="0,14,0,0">
                                <TextBlock Style="{StaticResource Text.Section}" Text="ARGUMENTOS (OPCIONAL)" Margin="0,0,0,6" />
                                <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" t:Attached.Hint="Por ejemplo: --nueva-ventana" />
                                <TextBlock Style="{StaticResource Text.Section}" Text="CARPETA DE TRABAJO (OPCIONAL)" Margin="0,14,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" t:Attached.Hint="Ruta completa" />
                                    <Button Grid.Column="1" Content="Examinar…" Command="{Binding PickWorkingDirectory}" Margin="8,0,0,0" />
                                </Grid>
                            </StackPanel>

                            <!-- Dirección web -->
                            <StackPanel Visibility="{Binding IsUrl, Converter={StaticResource VisibleWhenTrue}}" Margin="0,14,0,0">
                                <TextBlock Style="{StaticResource Text.Section}" Text="DIRECCIÓN" Margin="0,0,0,6" />
                                <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" t:Attached.Hint="https://…" />
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0" Text="Solo se admiten direcciones http y https." />
                            </StackPanel>

                            <TextBlock Style="{StaticResource Text.Section}" Text="CATEGORÍA" Margin="0,14,0,6" />
                            <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedValuePath="Category" ItemTemplate="{StaticResource Template.Name}" SelectedValue="{Binding Category, Mode=TwoWay}" />

                            <TextBlock Style="{StaticResource Text.Section}" Text="DESCRIPCIÓN (OPCIONAL)" Margin="0,14,0,6" />
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="False" MaxLength="500" MinHeight="64" VerticalContentAlignment="Top"
                                     t:Attached.Hint="Para qué sirve" />

                            <TextBlock Style="{StaticResource Text.Section}" Text="ETIQUETAS (SEPARADAS POR COMAS)" Margin="0,14,0,6" />
                            <TextBox Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}" t:Attached.Hint="trabajo, texto" />

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,6"><TextBlock Style="{StaticResource Text.Section}" Text="ICONO" VerticalAlignment="Center" /><c:GlyphIcon Glyph="{Binding IconName}" FontSize="16" Foreground="{DynamicResource Brush.Accent}" Margin="10,0,0,0" /></StackPanel>
                            <c:IconPicker x:Name="FormIcons" Loaded="OnFormIconsLoaded" />
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Brush.Border}" Padding="20,12">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding Form.Problems}" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="0,0,0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancelar" Command="{Binding CancelForm}" Style="{StaticResource Button.Ghost}" Margin="0,0,8,0" />
                                <Button Content="Guardar acción" Command="{Binding SaveForm}" Style="{StaticResource Button.Primary}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<Window x:Class="Radial.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Radial.App.Views"
        Title="Radial" Width="1320" Height="840" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Brush.Bg}"
        FontFamily="{DynamicResource Font.Text}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!-- La ventana solo aloja el centro de control; la navegación, las secciones y los diálogos están en ShellView. -->
    <v:ShellView x:Name="Shell" />
</Window>

<UserControl x:Class="Radial.App.Controls.IconPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Radial.App.Controls">
    <!-- Cuadrícula de iconos del catálogo; el elegido se marca. -->
    <ItemsControl x:Name="Items">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Button Width="36" Height="36" Margin="0,0,4,4" Padding="0" Click="OnChoose" Tag="{Binding}" ToolTip="{Binding}"
                        Background="{DynamicResource Brush.Surface1}">
                    <c:GlyphIcon Glyph="{Binding}" FontSize="16" />
                </Button>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>

<UserControl x:Class="Radial.App.Controls.KeyCaptureBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Radial.App.Controls"
             LostKeyboardFocus="OnLostFocus">
    <!-- Selector de atajo: grabar la combinación (solo mientras se activa el modo de grabación) o elegirla a mano. -->
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Field" Focusable="True" MinHeight="44" CornerRadius="{DynamicResource Radius.M}" BorderThickness="1" Padding="14,0"
                    Background="{DynamicResource Brush.Surface1}" BorderBrush="{DynamicResource Brush.Border}"
                    PreviewKeyDown="OnPreviewKeyDown" PreviewKeyUp="OnPreviewKeyUp" FocusVisualStyle="{x:Null}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                <Setter Property="Background" Value="{DynamicResource Brush.AccentSubtle}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <c:GlyphIcon Glyph="Keyboard" Margin="0,0,10,0" Foreground="{DynamicResource Brush.TextMuted}" />
                    <TextBlock Text="{Binding Display}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                <Button Content="Grabar" Click="OnRecord" Style="{StaticResource Button.Primary}" MinHeight="44" Padding="16,0" />
                <Button Content="Borrar" Click="OnClear" Margin="6,0,0,0" MinHeight="44" Padding="14,0" Style="{StaticResource Button.Ghost}" />
            </StackPanel>
        </Grid>

        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding IsRecording, Converter={StaticResource VisibleWhenTrue}}"
                   Text="Pulsa la combinación. Esc cancela la grabación. Si Windows se queda la combinación (por ejemplo Win+E), elígela a mano más abajo." />
        <TextBlock Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap" Margin="0,8,0,0" Text="{Binding Message}"
                   Visibility="{Binding Message.Length, Converter={StaticResource VisibleWhenNotZero}}" />

        <TextBlock Style="{StaticResource Text.Section}" Text="ELEGIR A MANO" Margin="0,16,0,8" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <ToggleButton Content="Ctrl" Style="{StaticResource ToggleButton.Chip}" IsChecked="{Binding Control, Mode=TwoWay}" Margin="0,0,6,0" />
            <ToggleButton Content="Mayús" Style="{StaticResource ToggleButton.Chip}" IsChecked="{Binding Shift, Mode=TwoWay}" Margin="0,0,6,0" />
            <ToggleButton Content="Alt" Style="{StaticResource ToggleButton.Chip}" IsChecked="{Binding Alt, Mode=TwoWay}" Margin="0,0,6,0" />
            <ToggleButton Content="Win" Style="{StaticResource ToggleButton.Chip}" IsChecked="{Binding Windows, Mode=TwoWay}" />
        </StackPanel>
        <ComboBox ItemsSource="{Binding Options}" SelectedValuePath="Name" SelectedValue="{Binding KeyName, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" />
                        <TextBlock Grid.Column="1" Text="{Binding GroupName}" Style="{StaticResource Text.Caption}" Margin="16,0,0,0" />
                    </Grid>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                   Text="{Binding LayoutName, StringFormat='Los nombres de las teclas siguen tu teclado actual ({0}). La combinación se guarda por tecla física, así que funciona igual con cualquier distribución.'}" />
    </StackPanel>
</UserControl>

<Window x:Class="Radial.BlurSpike.Harness.ControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Radial BlurSpike — harness de diagnóstico" Width="540" Height="700"
        WindowStartupLocation="Manual">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Variante" FontWeight="SemiBold" />
            <ComboBox x:Name="VariantBox" SelectionChanged="OnVariantChanged" Margin="0,2,0,2" />
            <TextBlock x:Name="TechniqueText" TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,8" />

            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="56" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Tamaño (DIP)" VerticalAlignment="Center" />
                <ComboBox Grid.Row="0" Grid.Column="1" x:Name="SizeBox" Margin="0,2" />

                <TextBlock Grid.Row="1" Text="Opacidad del tinte" VerticalAlignment="Center" />
                <Slider Grid.Row="1" Grid.Column="1" x:Name="OpacitySlider" Minimum="0" Maximum="1" Value="0.5" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Value, ElementName=OpacitySlider, StringFormat=F2}" HorizontalAlignment="Right" />

                <TextBlock Grid.Row="2" Text="Radio de blur (E)" VerticalAlignment="Center" />
                <Slider Grid.Row="2" Grid.Column="1" x:Name="BlurSlider" Minimum="0" Maximum="60" Value="24" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Value, ElementName=BlurSlider, StringFormat=F0}" HorizontalAlignment="Right" />

                <TextBlock Grid.Row="3" Text="Click-through" VerticalAlignment="Center" />
                <ComboBox Grid.Row="3" Grid.Column="1" x:Name="ClickBox" Margin="0,2" />

                <TextBlock Grid.Row="4" Text="Backdrop (B, C)" VerticalAlignment="Center" />
                <ComboBox Grid.Row="4" Grid.Column="1" x:Name="BackdropBox" Margin="0,2" />

                <TextBlock Grid.Row="5" Text="Acento (D)" VerticalAlignment="Center" />
                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                    <ComboBox x:Name="AccentBox" Width="190" Margin="0,2" />
                    <CheckBox x:Name="CircularBox" Content="región circular" IsChecked="True" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="Show" Click="OnShow" Padding="14,4" Margin="0,0,6,0" />
                <Button Content="Hide" Click="OnHide" Padding="14,4" Margin="0,0,6,0" />
                <Button Content="Prueba de foco" Click="OnFocusTest" Padding="10,4" Margin="0,0,6,0" />
                <Button Content="Prueba de clic" Click="OnClickTest" Padding="10,4" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="Batería automática (todas)" Click="OnAuto" Padding="10,4" />
            </StackPanel>

            <TextBlock x:Name="StatusText" FontFamily="Consolas" Margin="0,10,0,4" TextWrapping="Wrap" />
        </StackPanel>

        <TextBox Grid.Row="1" x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
    </Grid>
</Window>
